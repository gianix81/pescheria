APP_NAME="Pescheria Ordini"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# L'app salva sempre in UTC e mostra in Europe/Rome
APP_TIMEZONE=UTC
APP_DISPLAY_TIMEZONE=Europe/Rome
APP_LOCALE=it
APP_FALLBACK_LOCALE=it
APP_FAKER_LOCALE=it_IT

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pescheria
DB_USERNAME=root
DB_PASSWORD=

# Database usato dalla suite di test (phpunit.xml)
DB_TEST_DATABASE=pescheria_test

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database
CACHE_STORE=database

# --- Storage media ---------------------------------------------------------
# media_local (disco privato locale) oppure media_s3 (object storage)
FILESYSTEM_DISK=local
MEDIA_DISK=media_local
MEDIA_MAX_IMAGE_MB=10
MEDIA_MAX_VIDEO_MB=100
MEDIA_SIGNED_URL_MINUTES=30
MEDIA_ANTIVIRUS_ENABLED=false

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-south-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@pescheria.local"
MAIL_FROM_NAME="${APP_NAME}"

# --- Notifiche -------------------------------------------------------------
NOTIFY_EMAIL_ENABLED=false
NOTIFY_WHATSAPP_ENABLED=false
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_ID=
# Minuti prima della scadenza in cui parte il sollecito ai CR mancanti
NOTIFY_REMINDER_MINUTES=120,30

VITE_APP_NAME="${APP_NAME}"
