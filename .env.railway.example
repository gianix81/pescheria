# ---------------------------------------------------------------------------
# Variabili per Railway — servizio App
# Incollare nel Raw Editor (Variables → Raw Editor) del servizio.
#
# I riferimenti ${{MySQL.*}} presuppongono che il servizio database si chiami
# "MySQL", il nome predefinito. Se l'hai rinominato, adegua il prefisso.
# APP_KEY va sostituita con una propria: php artisan key:generate --show
# ---------------------------------------------------------------------------

# Document root dell'applicazione (Nixpacks)
NIXPACKS_PHP_ROOT_DIR=/app/public

APP_NAME=Ordini pescheria
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Il dominio pubblico non esiste finché il primo deploy non è andato a buon fine:
# al primo build il riferimento ${{RAILWAY_PUBLIC_DOMAIN}} resta non risolto.
# Lascia questa riga com'è al primo tentativo, poi sostituiscila con il dominio
# reale (Settings → Networking) perché i link nelle notifiche siano corretti.
APP_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}

APP_TIMEZONE=UTC
APP_DISPLAY_TIMEZONE=Europe/Rome
APP_LOCALE=it
APP_FALLBACK_LOCALE=it
APP_FAKER_LOCALE=it_IT

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# --- Database (plugin MySQL di Railway) ------------------------------------
DB_CONNECTION=mysql
DB_HOST=${{MySQL.MYSQLHOST}}
DB_PORT=${{MySQL.MYSQLPORT}}
DB_DATABASE=${{MySQL.MYSQLDATABASE}}
DB_USERNAME=${{MySQL.MYSQLUSER}}
DB_PASSWORD=${{MySQL.MYSQLPASSWORD}}

# Il container è persistente: sessioni, cache e code sul database
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

# --- Media ------------------------------------------------------------------
# Con un volume montato su /app/storage i file sopravvivono ai deploy.
FILESYSTEM_DISK=local
MEDIA_DISK=media_local
MEDIA_MAX_IMAGE_MB=10
MEDIA_MAX_VIDEO_MB=100
MEDIA_SIGNED_URL_MINUTES=30
MEDIA_ANTIVIRUS_ENABLED=false

# Compressione nel browser prima dell'invio
MEDIA_IMG_LATO_MAX=1920
MEDIA_IMG_QUALITA=0.82
MEDIA_VIDEO_LATO_MAX=1280
MEDIA_VIDEO_FPS=30

# --- Modalità dimostrativa disattivata --------------------------------------
DEMO_MODE=false

# --- Comandi pianificati ----------------------------------------------------
# Serve solo se NON si crea il servizio Scheduler. openssl rand -hex 32
CRON_SECRET=
NOTIFY_REMINDER_MINUTES=120,30

# --- Notifiche --------------------------------------------------------------
NOTIFY_EMAIL_ENABLED=false
NOTIFY_WHATSAPP_ENABLED=false
MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@pescheria.local
MAIL_FROM_NAME=Ordini pescheria
