# ---------------------------------------------------------------------------
# Variabili da impostare nel pannello Vercel (Project → Settings → Environment
# Variables). Nessun valore reale va committato in questo file.
# Vedi docs/06-deploy-vercel.md per il contesto e i limiti della piattaforma.
#
# ATTENZIONE: non creare una variabile lasciandone il valore in bianco.
# Una variabile presente ma vuota NON attiva il valore predefinito: o le dai un
# valore, o la elimini. La configurazione dell'app è comunque difesa da questo
# caso (config/app.php usa `env(...) ?: default`), ma le variabili senza un
# predefinito sensato — APP_KEY, DB_*, AWS_* — restano obbligatorie.
# ---------------------------------------------------------------------------

APP_NAME="Ordini pescheria"
APP_ENV=production
APP_DEBUG=false
# php artisan key:generate --show
APP_KEY=
APP_URL=https://<progetto>.vercel.app

APP_TIMEZONE=UTC
APP_DISPLAY_TIMEZONE=Europe/Rome
APP_LOCALE=it
APP_FALLBACK_LOCALE=it

# Filesystem in sola lettura: storage/ deve stare in /tmp
APP_STORAGE_PATH=/tmp/storage
VIEW_COMPILED_PATH=/tmp/storage/framework/views

# I log vanno allo stream, non su file: si leggono in Vercel → Logs
LOG_CHANNEL=stderr
LOG_STACK=stderr
LOG_LEVEL=warning

# --- MySQL gestito esterno (obbligatorio) ----------------------------------
# Deve supportare SELECT ... FOR UPDATE: da quel lock dipende la garanzia
# che la disponibilità limitata non venga mai superata.
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
# Solo se il provider richiede un certificato CA per il TLS; se non serve,
# NON creare la variabile (un percorso inesistente fa fallire la connessione).
# MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt

# Sessioni e cache sul database: /tmp non è condiviso fra invocazioni
SESSION_DRIVER=database
CACHE_STORE=database

# Nessun worker persistente: i job vengono eseguiti nella stessa richiesta
QUEUE_CONNECTION=sync

# --- Object storage (obbligatorio) -----------------------------------------
# I media non possono stare sul filesystem della funzione.
FILESYSTEM_DISK=s3
MEDIA_DISK=media_s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-south-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Upload diretto dal browser a S3: aggira il limite di 4,5 MB per richiesta
# delle funzioni Vercel e permette i video fino a 100 MB.
LIVEWIRE_TEMPORARY_FILE_UPLOAD_DISK=s3
MEDIA_MAX_IMAGE_MB=10
MEDIA_MAX_VIDEO_MB=100
MEDIA_SIGNED_URL_MINUTES=30

# --- Comandi pianificati ----------------------------------------------------
# Segreto dell'endpoint /cron/esegui. Generalo con: openssl rand -hex 32
CRON_SECRET=

# --- Notifiche --------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
NOTIFY_EMAIL_ENABLED=true
NOTIFY_WHATSAPP_ENABLED=false
NOTIFY_REMINDER_MINUTES=120,30
